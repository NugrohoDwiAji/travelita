// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

enum BookingType {
  SHUTTLE
  TRIP
  PRIVATE_CAR
  SPEAR_CAR
  TICKET
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  PROCESSING
}

enum ShuttleType {
 ONE_WAY
 ROUND_TRIP
}

enum UserRole {
  USER
  ADMIN
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile?
  bookings  Booking[]

  @@map("user")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  country   String?
  city     String
  profilePicture String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id])
@@map("profile")
}

model Booking {
  id           Int           @id @default(autoincrement())
  userId       String
  details      Int
  type         BookingType
  status       BookingStatus
  paymentProof String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  @@map("booking")
}

model ServiceContent {
  id           String           @id @default(uuid())
  serviceType  BookingType      @unique
  badge        String?
  title        String
  subtitle     String?
  description  String           @db.Text
  ctaPrimary   String?
  ctaSecondary String?
  packages     ServicePackage[]
  faqs         ServiceFaq[]
  routes       ServiceRoute[]
  spots        ServiceSpot[]
  privateCarPricing PrivateCarPricing?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("service_content")
}

model ServicePackage {
  id          String         @id @default(uuid())
  contentId   String
  name        String
  description String?        @db.Text
  price       Float
  features    String         @db.Text
  badge       String?
  highlighted Boolean        @default(false)
  content     ServiceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("service_package")
}

model ServiceFaq {
  id        String         @id @default(uuid())
  contentId String
  question  String
  answer    String         @db.Text
  content   ServiceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("service_faq")
}

model ServiceRoute {
  id          String         @id @default(uuid())
  contentId   String
  from        String
  to          String
  duration    String
  price       Float
  tag         String?
  type        String?
  icon        String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  content     ServiceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("service_route")
}

model ServiceSpot {
  id          String         @id @default(uuid())
  contentId   String
  name        String
  region      String
  depth       String
  price       Float          @default(0)
  fish        String?
  level       String?
  tag         String?
  order       Int            @default(0)
  isBestSeller Boolean      @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  content     ServiceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("service_spot")
}

model PrivateCarPricing {
  id                String   @id @default(uuid())
  contentId         String   @unique
  basePrice         Float    @default(350000)
  fullDayMultiplier Float    @default(1.8)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  content           ServiceContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("private_car_pricing")
}

model ShuttleBooking {
  id        Int      @id @default(autoincrement())
  shuttleType ShuttleType
  from String
  to String
  leavingTime DateTime
  returnTime DateTime?
  passengerCount Int
  price Float
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shuttle_booking")
}
